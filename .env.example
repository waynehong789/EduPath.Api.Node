# copy to backend/.env; development values only
DATABASE_URL="postgresql://edupath:local_dev_only@127.0.0.1:5432/edupath?schema=public"
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
# Never enable in production. DEV_AUTH_ENABLED is rejected when NODE_ENV=production.
DEV_AUTH_ENABLED=true
# Cognito mode: set both, turn DEV_AUTH_ENABLED=false
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=ap-southeast-2
